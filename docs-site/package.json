{
  "name": "cors-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Trang hướng dẫn sử dụng hệ thống quản lý trạm CORS/NTRIP/RTCM",
  "scripts": {
    "start": "docusaurus start --port 3100 --host 127.0.0.1 --no-open",
    "dev": "docusaurus start --port 3100 --host 127.0.0.1 --no-open",
    "build": "docusaurus build",
    "serve": "docusaurus serve --port 3100 --host 127.0.0.1 --no-open",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "5.7.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
