# Runtime
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
APP_TIMEZONE=Asia/Ho_Chi_Minh
MYSQL_TIMEZONE=+00:00
PORT=4000
GO_PORT=7080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ADMIN_DATABASE=cors_admin
MYSQL_RUNTIME_DATABASE=cors_runtime
MYSQL_ROOT_PASSWORD=__SET_IN_ENV_LOCAL__
MYSQL_APP_USER=cors_app
MYSQL_APP_PASSWORD=__SET_IN_ENV_LOCAL__
MYSQL_RELAY_USER=cors_relay
MYSQL_RELAY_PASSWORD=__SET_IN_ENV_LOCAL__
MYSQL_MIGRATOR_USER=cors_migrator
MYSQL_MIGRATOR_PASSWORD=__SET_IN_ENV_LOCAL__

# Session
SESSION_COOKIE_NAME=cors_sid
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false

# Security (dùng ở các phase sau)
SESSION_SECRET=__SET_IN_ENV_LOCAL__
APP_ENC_KEY=__SET_IN_ENV_LOCAL__
INTERNAL_HMAC_SECRET=__SET_IN_ENV_LOCAL__

# Seed mật khẩu dev (chỉ dùng trong .env.local, không commit)
SEED_SUPERADMIN_PASSWORD=__SET_IN_ENV_LOCAL__
SEED_ADMIN_PASSWORD=__SET_IN_ENV_LOCAL__
SEED_USER_PASSWORD=__SET_IN_ENV_LOCAL__
SEED_NTRIP_PASSWORD=__SET_IN_ENV_LOCAL__

# Services
GO_INTERNAL_URL=http://gnss:7080
CASTER_PORT=2101

# Relay import (Phase 2)
RELAY_IMPORT_PATH=__ABSOLUTE_PATH_ON_HOST__
RELAY_IMPORT_IDS=

# NTRIP test (Phase 2; không commit giá trị thật)
NTRIP_TEST_HOST=
NTRIP_TEST_PORT=
NTRIP_TEST_VERSION=1
NTRIP_TEST_USER=
NTRIP_TEST_PASS=

# Ghi chú:
# - Không commit .env.local.
# - Không dùng giá trị placeholder cho production.
# - APP_ENC_KEY nên là 32 byte ngẫu nhiên, mã base64.
# - SESSION_SECRET và INTERNAL_HMAC_SECRET nên ngẫu nhiên, đủ dài.
