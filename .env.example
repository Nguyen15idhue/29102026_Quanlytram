# Runtime
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
APP_TIMEZONE=Asia/Ho_Chi_Minh
MYSQL_TIMEZONE=+00:00
PORT=4000
GO_PORT=7080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ADMIN_DATABASE=cors_admin
MYSQL_RUNTIME_DATABASE=cors_runtime
MYSQL_ROOT_PASSWORD=__SET_IN_ENV_LOCAL__
MYSQL_APP_USER=cors_app
MYSQL_APP_PASSWORD=__SET_IN_ENV_LOCAL__
MYSQL_RELAY_USER=cors_relay
MYSQL_RELAY_PASSWORD=__SET_IN_ENV_LOCAL__
MYSQL_MIGRATOR_USER=cors_migrator
MYSQL_MIGRATOR_PASSWORD=__SET_IN_ENV_LOCAL__

# Session
SESSION_COOKIE_NAME=cors_sid
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT=10

# Security (dùng ở các phase sau)
SESSION_SECRET=__SET_IN_ENV_LOCAL__
APP_ENC_KEY=__SET_IN_ENV_LOCAL__
INTERNAL_HMAC_SECRET=__SET_IN_ENV_LOCAL__

# Seed mật khẩu dev (chỉ dùng trong .env.local, không commit)
SEED_SUPERADMIN_PASSWORD=__SET_IN_ENV_LOCAL__
SEED_ADMIN_PASSWORD=__SET_IN_ENV_LOCAL__
SEED_USER_PASSWORD=__SET_IN_ENV_LOCAL__
SEED_NTRIP_PASSWORD=__SET_IN_ENV_LOCAL__

# Services
GO_INTERNAL_URL=http://gnss:7080
INTERNAL_TIMEOUT_MS=5000
REALTIME_POLL_MS=1000
CASTER_PORT=1509
CASTER_BIND_ADDR=0.0.0.0
CASTER_POLL_INTERVAL_SEC=10
CASTER_HEADER_TIMEOUT_SEC=10
CASTER_WRITE_TIMEOUT_SEC=10
CASTER_QUEUE_SIZE=64
CASTER_READ_BUFFER=32768
CASTER_MAX_HEADER_BYTES=16384

# Relay runtime (Phase 2)
RELAY_POLL_INTERVAL_SEC=10
RELAY_FLUSH_INTERVAL_SEC=1
RELAY_QUEUE_SIZE=10000
RELAY_BATCH_SIZE=100
RELAY_DIAL_TIMEOUT_SEC=15
RELAY_SHUTDOWN_TIMEOUT_SEC=10
RELAY_SESSION_RETENTION_DAYS=90
RELAY_EVENT_RETENTION_DAYS=30
RELAY_HOURLY_RETENTION_DAYS=90
RELAY_PRUNE_BATCH=1000
RELAY_PRUNE_INTERVAL_SEC=3600

# Relay import (Phase 2)
RELAY_IMPORT_PATH=__ABSOLUTE_PATH_ON_HOST__
RELAY_IMPORT_IDS=

# NTRIP test (Phase 2; không commit giá trị thật)
NTRIP_TEST_HOST=
NTRIP_TEST_PORT=
NTRIP_TEST_VERSION=1
NTRIP_TEST_USER=
NTRIP_TEST_PASS=

# Ghi chú:
# - Không commit .env.local.
# - Không dùng giá trị placeholder cho production.
# - APP_ENC_KEY nên là 32 byte ngẫu nhiên, mã base64.
# - SESSION_SECRET và INTERNAL_HMAC_SECRET nên ngẫu nhiên, đủ dài.

# RTCM quality (Phase 6)
QUALITY_QUEUE_SIZE=2048
QUALITY_SAMPLE_INTERVAL_SEC=60
QUALITY_STATS_INTERVAL_SEC=10
QUALITY_EVAL_INTERVAL_SEC=5
QUALITY_ALERT_WINDOWS=3
QUALITY_GAP_MS=2000
QUALITY_STALE_AFTER_SEC=5
QUALITY_BASELINE_WINDOW=120
QUALITY_SAMPLE_WINDOW_SEC=60
QUALITY_STORE_QUEUE_SIZE=4096
QUALITY_SAMPLE_RETENTION_DAYS=30
QUALITY_ALERT_RETENTION_DAYS=90
QUALITY_PRUNE_BATCH=1000
QUALITY_PRUNE_INTERVAL_SEC=21600
